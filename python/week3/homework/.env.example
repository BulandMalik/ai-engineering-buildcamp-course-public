# Copy this file to .env and fill in the values.
# .env is ignored by git. Do not put real keys in this example.

# Azure OpenAI deployment name, not the public model id.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Key and endpoint from the Azure OpenAI resource.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# API version for that deployment, for example 2024-10-21.
AZURE_OPENAI_API_VERSION=

# Timeouts in seconds for the Azure client. The SDK default connect
# timeout is 5 seconds, which is too short when the endpoint is reached
# through a local proxy.
OPENAI_CLIENT_CONNECT_TIMEOUT=30
OPENAI_CLIENT_READ_TIMEOUT=120
OPENAI_CLIENT_WRITE_TIMEOUT=30
OPENAI_CLIENT_POOL_TIMEOUT=30
